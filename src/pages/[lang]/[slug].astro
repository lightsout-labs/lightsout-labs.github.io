---
import { getCollection, render } from "astro:content";
import Facts from "../../components/Facts.astro";
import Base from "../../layouts/Base.astro";
import { seriesOf } from "../../lib/series/index.ts";

export async function getStaticPaths() {
  const series = seriesOf(await getCollection("articles"), import.meta.env.SITE);
  return (["en", "zh"] as const).flatMap((lang) =>
    series.articles(lang).map((article) => ({
      params: { lang, slug: article.slug },
      props: {
        article,
        meta: series.pageMeta({ lang, slug: article.slug }),
        ...series.neighbours(lang, article.slug),
      },
    })),
  );
}

const { article, meta, previous, next } = Astro.props;
const words = {
  en: { series: "Series", previous: "Previous", next: "Next", all: "All parts" },
  zh: { series: "系列", previous: "上一篇", next: "下一篇", all: "全部文章" },
}[article.lang];
const { Content } = await render(article.entry);
---

<Base meta={meta}>
  <header>
    <a class="site-name" href={`/${article.lang}/`}>
      Lightsout Labs
    </a>
  </header>
  <main>
    <article>
      <h1>{article.title}</h1>
      <Facts
        lang={article.lang}
        date={article.date}
        minutes={article.minutes}
        part={article.part}
        byline
      />
      <div class="body">
        <Content />
      </div>
    </article>
    <nav class="series-nav" aria-label={words.series}>
      {previous && (
        <a rel="prev" href={`/${article.lang}/${previous.slug}/`}>
          <span>{words.previous}</span> {previous.title}
        </a>
      )}
      {next && (
        <a rel="next" href={`/${article.lang}/${next.slug}/`}>
          <span>{words.next}</span> {next.title}
        </a>
      )}
      <a href={`/${article.lang}/`}>{words.all}</a>
    </nav>
  </main>
</Base>
