---
import { getCollection } from "astro:content";
import Facts from "../../components/Facts.astro";
import Base from "../../layouts/Base.astro";
import { seriesOf } from "../../lib/series/index.ts";

export function getStaticPaths() {
  return [
    {
      params: { lang: "en" as const },
      props: { heading: "The series" },
    },
    {
      params: { lang: "zh" as const },
      props: { heading: "系列文章" },
    },
  ];
}

const { lang } = Astro.params;
const { heading } = Astro.props;
const series = seriesOf(await getCollection("articles"), import.meta.env.SITE);
const articles = series.articles(lang);
const meta = series.pageMeta({ lang });
---

<Base meta={meta}>
  <header>
    <p class="site-name">Lightsout Labs</p>
    <p class="tagline">{meta.description}</p>
  </header>
  <main>
    <h1>{heading}</h1>
    <ol class="series">
      {articles.map((a) => (
        <li>
          <h2>
            <a href={`/${lang}/${a.slug}/`}>{a.title}</a>
          </h2>
          <p>{a.description}</p>
          <Facts lang={lang} date={a.date} minutes={a.minutes} />
        </li>
      ))}
    </ol>
  </main>
</Base>
