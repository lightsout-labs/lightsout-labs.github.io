---
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return [
    {
      params: { lang: "en" },
      props: {
        htmlLang: "en",
        tagline:
          "Notes on the lights-out software factory, where an AI agent builds the software and people decide at a few gates.",
        heading: "The series",
        empty: "No articles yet.",
      },
    },
    {
      params: { lang: "zh" },
      props: {
        htmlLang: "zh-CN",
        tagline: "关于“熄灯软件工厂”的系列文章：AI 智能体负责开发软件，人只在几个关口做决定。",
        heading: "系列文章",
        empty: "暂无文章。",
      },
    },
  ];
}

const { htmlLang, tagline, heading, empty } = Astro.props;
---

<Base lang={htmlLang} title="Lightsout Labs" description={tagline}>
  <header>
    <p class="site-name">Lightsout Labs</p>
    <p class="tagline">{tagline}</p>
  </header>
  <main>
    <h1>{heading}</h1>
    <p class="muted">{empty}</p>
  </main>
</Base>
