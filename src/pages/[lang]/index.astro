---
import { getCollection } from "astro:content";
import Facts from "../../components/Facts.astro";
import Base from "../../layouts/Base.astro";
import { seriesOf } from "../../lib/series/index.ts";

export function getStaticPaths() {
  return [
    {
      params: { lang: "en" as const },
      props: {
        htmlLang: "en",
        tagline:
          "Notes on the lights-out software factory, where an AI agent builds the software and people decide at a few gates.",
        heading: "The series",
      },
    },
    {
      params: { lang: "zh" as const },
      props: {
        htmlLang: "zh-CN",
        tagline: "关于“熄灯软件工厂”的系列文章：AI 智能体负责开发软件，人只在几个关口做决定。",
        heading: "系列文章",
      },
    },
  ];
}

const { lang } = Astro.params;
const { htmlLang, tagline, heading } = Astro.props;
const articles = seriesOf(await getCollection("articles")).articles(lang);
---

<Base lang={htmlLang} title="Lightsout Labs" description={tagline}>
  <header>
    <p class="site-name">Lightsout Labs</p>
    <p class="tagline">{tagline}</p>
  </header>
  <main>
    <h1>{heading}</h1>
    <ol class="series">
      {articles.map((a) => (
        <li>
          <h2>
            <a href={`/${lang}/${a.slug}/`}>{a.title}</a>
          </h2>
          <p>{a.description}</p>
          <Facts lang={lang} date={a.date} minutes={a.minutes} />
        </li>
      ))}
    </ol>
  </main>
</Base>
